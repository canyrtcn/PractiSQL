{
  "name": "practisql",
  "version": "3.4.262",
  "description": "PractiSQL — A simple, AI-powered SQL playground.",
  "main": "app/main.js",
  "build": {
    "appId": "com.canyrtcn.practisql",
    "productName": "PractiSQL",
    "artifactName": "PractiSQL Setup ${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "app",
        "to": ".",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      "package.json",
      "node_modules/sql.js/dist/**"
    ],
    "asar": false,
    "win": {
      "icon": "app/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PractiSQL",
      "installerIcon": "app/assets/icon.ico",
      "uninstallerIcon": "app/assets/icon.ico",
      "installerHeaderIcon": "app/assets/icon.ico",
      "installerHeader": "app/assets/nsis-header.bmp",
      "installerSidebar": "app/assets/nsis-sidebar.bmp",
      "include": "app/assets/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "canyrtcn",
      "repo": "practisql"
    },
    "extraMetadata": {
      "main": "main.js"
    }
  },
  "author": "PractiSQL contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test:db": "node scripts/test-db.js",
    "test:ipc": "node scripts/test-ipc.js",
    "test:security": "node --test scripts/test-security.cjs",
    "test:stream": "node --test scripts/test-chatgpt-stream.cjs",
    "test:schema": "node scripts/test-schema.cjs",
    "test:security:integration": "node scripts/test-security-integration.cjs",
    "test:ui": "node scripts/test-publication-ui.cjs",
    "test:docs": "node scripts/test-public-docs.cjs",
    "scan:source": "node scripts/scan-source.cjs",
    "docs:build": "node scripts/build-public-docs.cjs",
    "dist:win": "electron-builder --config config/electron-builder.release.cjs --win --publish never",
    "dist:win:unsigned": "electron-builder --win --publish never",
    "docs:showcase": "node scripts/build-showcase.cjs",
    "docs:showcase:render": "node scripts/render-showcase.cjs",
    "test:appearance": "node scripts/test-brand-motion.cjs",
    "test:companion": "node scripts/test-companion-ui.cjs",
    "test:workshop": "node scripts/test-home-workshop.cjs",
    "test:interface-details": "node scripts/test-interface-details.cjs",
    "test:layout": "node --test scripts/test-window-layout.cjs scripts/test-interface-scale.cjs",
    "postinstall": "node scripts/prepare-runtime.cjs",
    "docs:assets": "node scripts/build-repository-assets.cjs",
    "test:repository-docs": "node scripts/test-repository-docs.cjs",
    "test:updater": "node scripts/test-updater-transport.cjs && node scripts/test-updater-ui.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mssql": "^11.0.2",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "elkjs": "^0.11.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
